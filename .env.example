PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/elevate_resume_studio
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=server/uploads

# OpenAI or another API with a compatible /chat/completions endpoint.
# Leave OPENAI_API_KEY empty to use transparent local keyword analysis.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
